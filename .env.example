# ==========================================
# MÉTHODE 1 : Google Calendar API (Recommandée)
# ==========================================
GOOGLE_CLIENT_ID="votre-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="votre-client-secret"
GOOGLE_REFRESH_TOKEN="votre-refresh-token"
# Optionnel : ID de l'agenda spécifique (laisser vide pour l'agenda principal)
GOOGLE_CALENDAR_ID="primary"

# ==========================================
# MÉTHODE 2 : iCal URL (Alternative)
# ==========================================
# Remplacez par votre URL secrète iCal :
GOOGLE_CALENDAR_ICAL_URL="https://calendar.google.com/calendar/ical/VOTRE_IDENTIFIANT/basic.ics"
